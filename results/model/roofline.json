  "latencies_provisional": true,
  "latencies": {
    "L_PE": 3,
    "L_RD": 2,
    "L_SETUP": 16,
    "L_RQ": 4,
    "L_WB": 1,
    "L_ACCEPT": 1,
    "L_DONE": 1
  },
  "x": "arithmetic_intensity (MACs per operand byte streamed)",
  "y": "macs_per_cycle (mac_useful / cycles_total)",
  "definitions": {
    "t_tile": "L_SETUP + (L_RD + K) + ((R-1) + (C-1) + L_PE) + T_DRAIN + L_RQ + L_WB; R = C = 8; T_DRAIN = 8 FULL / 4 STRIP, x4 when flags.out_int32",
    "tiles": "FULL ceil(M/8)*ceil(N/8); STRIP ceil(M/4)*ceil(N/16)",
    "cycles_total": "L_ACCEPT + tiles * T_tile + L_DONE",
    "util_model": "mac_useful / (64 * cycles_total)",
    "mapping_ceiling": "M*N / (64 * tiles): utilization if only the K MAC cycles of each tile counted",
    "operand_bytes_per_cycle": "A + W bytes read per STREAM cycle: FULL 8 A + 8 W = 16; STRIP 4 A + 16 W = 20",
    "arithmetic_intensity": "mac_useful / (tiles * K * operand_bytes_per_cycle): useful MACs per operand byte actually streamed from ABUF + WBUF (zero-padded lanes included; requant params and outputs excluded)"
  },
  "roofs": {
    "compute_macs_per_cycle": 64,
    "bandwidth": [
      {
        "mode": "FULL",
        "bytes_per_cycle": 16
      },
      {
        "mode": "STRIP",
        "bytes_per_cycle": 20
      }
    ]
  },
